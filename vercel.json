{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/__/auth/(.*)", "dest": "https://interview-prep-b2dd4.firebaseapp.com/__/auth/$1" },
    { "src": "/(.*)",       "dest": "/index.html" }
  ]
}
